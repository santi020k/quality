{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.santi020k.com/quality-local-ci-history.schema.json",
  "title": "quality local CI history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runs"],
  "properties": {
    "schema_version": { "const": 1 },
    "runs": {
      "type": "array",
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "status": { "enum": ["passed", "failed", "skipped"] },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hook", "started_at_unix_ms", "duration_ms", "status", "steps"],
      "properties": {
        "id": { "type": "string", "pattern": "^run-[0-9]+(?:-[0-9]{4})?$" },
        "hook": { "type": "string" },
        "started_at_unix_ms": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/$defs/status" },
        "steps": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
