{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.santi020k.com/quality.schema.json",
  "title": "quality.yml",
  "description": "Configuration for the quality code-quality orchestrator.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Configuration format version.",
      "const": 1,
      "default": 1
    },
    "output": {
      "description": "Default output format for checks.",
      "enum": ["pretty", "json", "sarif", "github"],
      "default": "pretty"
    },
    "baseline": {
      "description": "Repository-relative or absolute baseline file path.",
      "type": "string",
      "default": ".quality-baseline.json"
    },
    "tools": {
      "description": "Configuration for built-in adapters.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cargo-fmt": { "$ref": "#/$defs/builtInTool" },
        "cargo-clippy": { "$ref": "#/$defs/builtInTool" },
        "swiftlint": { "$ref": "#/$defs/builtInTool" },
        "swiftformat": { "$ref": "#/$defs/builtInTool" },
        "android-lint": { "$ref": "#/$defs/builtInTool" },
        "detekt": { "$ref": "#/$defs/builtInTool" },
        "ktlint": { "$ref": "#/$defs/builtInTool" },
        "eslint": { "$ref": "#/$defs/builtInTool" },
        "astro-check": { "$ref": "#/$defs/builtInTool" },
        "prettier": { "$ref": "#/$defs/builtInTool" },
        "cspell": { "$ref": "#/$defs/builtInTool" },
        "codespell": { "$ref": "#/$defs/builtInTool" },
        "typos": { "$ref": "#/$defs/builtInTool" },
        "knip": { "$ref": "#/$defs/builtInTool" },
        "actionlint": { "$ref": "#/$defs/builtInTool" }
      },
      "default": {}
    },
    "tasks": {
      "description": "Repository-defined checks run by quality check.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/adapterId" },
      "additionalProperties": { "$ref": "#/$defs/task" },
      "default": {}
    },
    "hooks": {
      "description": "Version-controlled steps for package-manager-independent Git hooks.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/hookEvent" },
      "additionalProperties": { "$ref": "#/$defs/hook" },
      "default": {}
    },
    "custom": {
      "description": "Custom file-oriented or project-wide analyzer adapters.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/adapterId" },
      "additionalProperties": { "$ref": "#/$defs/customTool" },
      "default": {}
    }
  },
  "$defs": {
    "adapterId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_-]+$"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]+$"
      }
    },
    "hookEvent": {
      "enum": [
        "applypatch-msg",
        "commit-msg",
        "fsmonitor-watchman",
        "post-applypatch",
        "post-checkout",
        "post-commit",
        "post-merge",
        "post-receive",
        "post-rewrite",
        "post-update",
        "pre-applypatch",
        "pre-auto-gc",
        "pre-commit",
        "pre-merge-commit",
        "pre-push",
        "pre-rebase",
        "pre-receive",
        "prepare-commit-msg",
        "proc-receive",
        "push-to-checkout",
        "reference-transaction",
        "sendemail-validate",
        "update"
      ]
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hookStep" }
        }
      }
    },
    "hookStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "name": { "type": "string" },
        "command": { "type": "string", "minLength": 1 },
        "args": { "$ref": "#/$defs/stringArray" },
        "working_directory": { "type": "string" },
        "pass_hook_args": { "type": "boolean", "default": false }
      }
    },
    "parser": {
      "enum": [
        "generic",
        "codespell",
        "eslint-json",
        "swiftlint-json",
        "ktlint-json",
        "typos-json"
      ],
      "default": "generic"
    },
    "builtInTool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "check": { "type": "boolean" },
        "required": { "type": "boolean" },
        "command": { "type": "string", "minLength": 1 },
        "working_directory": { "type": "string" },
        "check_args": { "$ref": "#/$defs/stringArray" },
        "format_args": { "$ref": "#/$defs/stringArray" },
        "fix_args": { "$ref": "#/$defs/stringArray" },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "name": { "type": "string" },
        "command": { "type": "string", "minLength": 1 },
        "args": { "$ref": "#/$defs/stringArray" },
        "working_directory": { "type": "string" },
        "required": { "type": "boolean", "default": true },
        "extensions": { "$ref": "#/$defs/extensions" },
        "config_files": { "$ref": "#/$defs/stringArray" },
        "parser": { "$ref": "#/$defs/parser" },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "customTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "name": { "type": "string" },
        "command": { "type": "string", "minLength": 1 },
        "working_directory": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "required": { "type": "boolean", "default": true },
        "extensions": { "$ref": "#/$defs/extensions" },
        "config_files": { "$ref": "#/$defs/stringArray" },
        "file_mode": {
          "enum": ["append", "project"],
          "default": "append"
        },
        "parser": { "$ref": "#/$defs/parser" },
        "check_args": { "$ref": "#/$defs/stringArray" },
        "format_check_args": { "$ref": "#/$defs/stringArray" },
        "format_args": { "$ref": "#/$defs/stringArray" },
        "fix_args": { "$ref": "#/$defs/stringArray" },
        "install_hint": { "type": "string" },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
