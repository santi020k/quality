{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality.santi020k.com/quality-impact-verification.schema.json",
  "title": "Quality impact verification report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "head", "passed", "checked_nodes", "failures"],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "$ref": "quality-impact-plan.schema.json#/$defs/planId" },
    "head": { "$ref": "quality-impact-plan.schema.json#/$defs/commitId" },
    "passed": { "type": "boolean" },
    "checked_nodes": { "type": "integer", "minimum": 0 },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "$ref": "quality-impact.schema.json#/$defs/nodeId" },
          "reason": { "enum": ["missing result", "passed result requires exit_code 0", "node failed", "node was cancelled", "selected node was skipped"] }
        }
      }
    }
  },
  "if": { "properties": { "passed": { "const": true } }, "required": ["passed"] },
  "then": { "properties": { "failures": { "type": "array", "maxItems": 0 } } },
  "else": { "properties": { "failures": { "type": "array", "minItems": 1 } } }
}
