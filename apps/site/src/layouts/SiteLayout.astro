---
import { SkipLink, Icon } from '@santi020k/lumen-astro';
import { ClientRouter, fade } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import UIPrimitives from '@santi020k/lumen-astro/runtime';
import MetadataHead from '@santi020k/og/astro/head';
import {
	articleSchema,
	breadcrumbSchema,
	composeJsonLd,
	offerSchema,
	organizationSchema,
	serializeJsonLd,
	softwareApplicationSchema,
	webSiteSchema,
} from '@santi020k/og/schema';
import { defineSite } from '@santi020k/og/site';
import { getSocialImagePath } from '../lib/social-image';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	pageType?: 'article' | 'website';
	sectionName?: string;
	socialImageAlt?: string;
}

const {
	title = 'quality — One quality command for every project',
	description = 'Run trusted code-quality tools for Rust, Swift, Android, Kotlin, JavaScript, TypeScript, Astro, and more through one deterministic workflow.',
	pageType = 'website',
	sectionName,
	socialImageAlt = `${sectionName ?? title} — quality code-quality CLI`,
} = Astro.props;
const publicSiteUrl = Astro.site ?? new URL('https://quality.santi020k.com');
const canonical = new URL(Astro.url.pathname, publicSiteUrl);
const socialImage = new URL(getSocialImagePath(Astro.url.pathname), publicSiteUrl);
const websiteId = new URL('/#website', publicSiteUrl).href;
const softwareId = new URL('/#software', publicSiteUrl).href;
const publisher = organizationSchema({ id: new URL('/#publisher', publicSiteUrl).href, name: 'Santiago Molina', url: 'https://santi020k.com' });
const website = webSiteSchema({
	description: 'A deterministic, multi-ecosystem code-quality CLI.',
	id: websiteId,
	inLanguage: 'en',
	name: 'quality',
	publisher,
	url: new URL('/', publicSiteUrl),
});
const software = softwareApplicationSchema({
	applicationCategory: 'DeveloperApplication',
	author: publisher,
	description: 'A deterministic CLI that orchestrates code-quality tools across multiple programming ecosystems.',
	downloadUrl: 'https://github.com/santi020k/quality/releases',
	id: softwareId,
	isAccessibleForFree: true,
	name: 'quality',
	offers: offerSchema({ currency: 'USD', price: 0 }),
	operatingSystem: ['Linux', 'macOS', 'Windows'],
	url: new URL('/', publicSiteUrl),
}, {
	alternateName: 'quality CLI',
	applicationSubCategory: 'Code quality tool',
	codeRepository: 'https://github.com/santi020k/quality',
	license: 'https://opensource.org/license/mit',
});
const article = pageType === 'article'
	? articleSchema({
			description,
			headline: sectionName ?? title,
			id: `${canonical.href}#article`,
			inLanguage: 'en',
			isPartOf: website,
			name: sectionName ?? title,
			type: 'TechArticle',
			url: canonical,
		}, {
			about: { '@id': softwareId, '@type': 'SoftwareApplication' },
			mainEntityOfPage: canonical.href,
		})
	: undefined;
const breadcrumbs = pageType === 'article'
	? breadcrumbSchema([
			{ name: 'quality', url: new URL('/', publicSiteUrl) },
			{ name: sectionName ?? title, url: canonical },
		])
	: undefined;
const structuredData = serializeJsonLd(composeJsonLd(publisher, website, software, article, breadcrumbs));
const site = defineSite({
	locale: 'en_US',
	publicImagePath: '/og/pages',
	siteName: 'quality',
	siteUrl: publicSiteUrl,
	twitter: { creator: '@santi020k', site: '@santi020k' },
});
const page = site.page({
	...(pageType === 'article' ? { article: { section: 'Documentation' } } : {}),
	authors: ['quality contributors'],
	canonical,
	description,
	image: { alt: socialImageAlt, type: 'image/webp', url: socialImage },
	pathname: Astro.url.pathname,
	robots: { index: true, maxImagePreview: 'large', maxSnippet: -1, maxVideoPreview: -1 },
	title,
	type: pageType,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<MetadataHead {page} site={site.options} />
		<meta name="author" content="quality contributors" />
		<meta name="color-scheme" content="light dark" />
		<link rel="sitemap" href="/sitemap.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#2563eb" />
		<meta property="og:image:secure_url" content={socialImage} />
		<script is:inline type="application/ld+json" set:html={structuredData} />
		<ClientRouter />
		<script is:inline data-astro-rerun>
			(() => {
				let theme = document.documentElement.dataset.theme;
				if (theme !== 'light' && theme !== 'dark') {
					try { theme = localStorage.getItem('quality-theme'); } catch { /* Storage may be unavailable. */ }
				}
				document.documentElement.dataset.theme = theme === 'light' || theme === 'dark'
					? theme : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			})();
		</script>
	</head>
	<body>
		<UIPrimitives />
		<SkipLink href="#main-content">Skip to content</SkipLink>
		<div class="site-shell">
			<SiteHeader />
			<main class="site-main" id="main-content" tabindex="-1" transition:name="quality-content" transition:animate={fade({ duration: '180ms' })}><slot /></main>
			<footer class="site-footer">
				<div class="footer-inner">
					<div class="footer-signature"><a href="/" class="footer-wordmark">quality<span aria-hidden="true">.</span></a><p>Keep your tools.<br />Find your rhythm.</p></div>
					<nav class="footer-links" aria-label="Footer navigation">
						<a href="/getting-started/">Read the docs <Icon name="arrow-up-right" decorative /></a>
						<a href="https://github.com/santi020k/quality" target="_blank" rel="noopener noreferrer">View source <Icon name="arrow-up-right" decorative /></a>
						<a href="/compatibility/">Compatibility <Icon name="arrow-up-right" decorative /></a>
					</nav>
				</div>
				<div class="footer-colophon"><span>Deterministic by design. Open source by choice.</span><span>Made by <a href="https://santi020k.com" target="_blank" rel="noopener noreferrer">santi020k</a> · Built with <a href="https://lumen.santi020k.com" target="_blank" rel="noopener noreferrer">Lumen</a></span></div>
			</footer>
		</div>
		<script>
			import '../scripts/site';
		</script>
	</body>
</html>
