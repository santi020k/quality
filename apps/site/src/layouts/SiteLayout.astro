---
import { ButtonLink, SkipLink, ThemeToggle, UIPrimitives } from '@santi020k/lumen-astro';
import MetadataHead from '@santi020k/og/astro/head';
import {
	articleSchema,
	breadcrumbSchema,
	composeJsonLd,
	offerSchema,
	organizationSchema,
	serializeJsonLd,
	softwareApplicationSchema,
	webSiteSchema,
} from '@santi020k/og/schema';
import { defineSite } from '@santi020k/og/site';
import { getSocialImagePath } from '../lib/social-image';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	pageType?: 'article' | 'website';
	sectionName?: string;
	socialImageAlt?: string;
}

const {
	title = 'quality — One quality command for every project',
	description = 'Run trusted code-quality tools for Rust, Swift, Android, Kotlin, JavaScript, TypeScript, Astro, and more through one deterministic workflow.',
	pageType = 'website',
	sectionName,
	socialImageAlt = `${sectionName ?? title} — quality code-quality CLI`,
} = Astro.props;
const publicSiteUrl = Astro.site ?? new URL('https://quality.santi020k.com');
const canonical = new URL(Astro.url.pathname, publicSiteUrl);
const socialImage = new URL(getSocialImagePath(Astro.url.pathname), publicSiteUrl);
const isDocs = Astro.url.pathname !== '/';
const websiteId = new URL('/#website', publicSiteUrl).href;
const softwareId = new URL('/#software', publicSiteUrl).href;
const publisher = organizationSchema({ id: new URL('/#publisher', publicSiteUrl).href, name: 'quality contributors' });
const website = webSiteSchema({
	description: 'A deterministic, multi-ecosystem code-quality CLI.',
	id: websiteId,
	inLanguage: 'en',
	name: 'quality',
	publisher,
	url: new URL('/', publicSiteUrl),
});
const software = softwareApplicationSchema({
	applicationCategory: 'DeveloperApplication',
	author: publisher,
	description: 'A deterministic CLI that orchestrates code-quality tools across multiple programming ecosystems.',
	downloadUrl: 'https://github.com/santi020k/quality/releases',
	id: softwareId,
	isAccessibleForFree: true,
	name: 'quality',
	offers: offerSchema({ currency: 'USD', price: 0 }),
	operatingSystem: ['Linux', 'macOS', 'Windows'],
	url: new URL('/', publicSiteUrl),
}, {
	alternateName: 'quality CLI',
	applicationSubCategory: 'Code quality tool',
	codeRepository: 'https://github.com/santi020k/quality',
	license: 'https://opensource.org/license/mit',
});
const article = pageType === 'article'
	? articleSchema({
			description,
			headline: sectionName ?? title,
			id: `${canonical.href}#article`,
			inLanguage: 'en',
			isPartOf: website,
			name: sectionName ?? title,
			type: 'TechArticle',
			url: canonical,
		}, {
			about: { '@id': softwareId, '@type': 'SoftwareApplication' },
			mainEntityOfPage: canonical.href,
		})
	: undefined;
const breadcrumbs = pageType === 'article'
	? breadcrumbSchema([
			{ name: 'quality', url: new URL('/', publicSiteUrl) },
			{ name: sectionName ?? title, url: canonical },
		])
	: undefined;
const structuredData = serializeJsonLd(composeJsonLd(publisher, website, software, article, breadcrumbs));
const site = defineSite({
	locale: 'en_US',
	publicImagePath: '/og/pages',
	siteName: 'quality',
	siteUrl: publicSiteUrl,
	twitter: { creator: '@santi020k', site: '@santi020k' },
});
const page = site.page({
	...(pageType === 'article' ? { article: { section: 'Documentation' } } : {}),
	authors: ['quality contributors'],
	canonical,
	description,
	image: { alt: socialImageAlt, type: 'image/webp', url: socialImage },
	pathname: Astro.url.pathname,
	robots: { index: true, maxImagePreview: 'large', maxSnippet: -1, maxVideoPreview: -1 },
	title,
	type: pageType,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<MetadataHead {page} site={site.options} />
		<meta name="author" content="quality contributors" />
		<meta name="color-scheme" content="light dark" />
		<link rel="sitemap" href="/sitemap.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#2563eb" />
		<meta property="og:image:secure_url" content={socialImage} />
		<script is:inline type="application/ld+json" set:html={structuredData} />
		<script is:inline>
			const theme = localStorage.getItem('quality-theme');
			if (theme) document.documentElement.dataset.theme = theme;
		</script>
	</head>
	<body>
		<UIPrimitives />
		<SkipLink href="#main-content">Skip to content</SkipLink>
		<div class="site-shell">
			<header class="site-header">
				<nav class="site-nav" aria-label="Primary navigation">
					<a class="wordmark" href="/" aria-label="quality home">
						<img class="wordmark-mark" src="/logo.svg" alt="" width="32" height="32" />
						<span>quality</span>
					</a>
					<div class="nav-links">
						<a class="nav-link" href="/overview/" aria-current={Astro.url.pathname === '/overview/' ? 'page' : undefined}>Why quality</a>
						<a class="nav-link" href="/getting-started/" aria-current={isDocs ? 'page' : undefined}>Docs</a>
						<a class="nav-link" href="/adapters/" aria-current={Astro.url.pathname === '/adapters/' ? 'page' : undefined}>Adapters</a>
					</div>
					<div class="nav-actions">
						<ThemeToggle aria-label="Toggle color theme" storageKey="quality-theme" />
						<ButtonLink class="github-link" href="https://github.com/santi020k/quality" newTab variant="ghost">GitHub</ButtonLink>
					</div>
				</nav>
			</header>
			<main class="site-main" id="main-content"><slot /></main>
			<footer class="site-footer">
				<div class="footer-inner">
					<span>Built for teams that care about the details.</span>
					<div class="footer-links">
						<a href="/getting-started/">Documentation</a>
						<a href="https://github.com/santi020k/quality">Source</a>
						<a href="https://santi020k.com">santi020k</a>
						<a href="https://lumen.santi020k.com">Lumen</a>
					</div>
				</div>
			</footer>
		</div>
	</body>
</html>
