---
import { ButtonLink, SkipLink, ThemeToggle, UIPrimitives } from '@santi020k/lumen-astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	pageType?: 'article' | 'website';
	sectionName?: string;
}

const {
	title = 'quality — One quality command for every project',
	description = 'Run trusted code-quality tools for Rust, Swift, Android, Kotlin, JavaScript, TypeScript, Astro, and more through one deterministic workflow.',
	pageType = 'website',
	sectionName,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/og.png', Astro.site);
const isDocs = Astro.url.pathname !== '/';
const websiteId = new URL('/#website', Astro.site).href;
const softwareId = new URL('/#software', Astro.site).href;
const graph: Record<string, unknown>[] = [
	{
		'@type': 'WebSite',
		'@id': websiteId,
		url: new URL('/', Astro.site).href,
		name: 'quality',
		description: 'A deterministic, multi-ecosystem code-quality CLI.',
		inLanguage: 'en',
	},
	{
		'@type': 'SoftwareApplication',
		'@id': softwareId,
		name: 'quality',
		alternateName: 'quality CLI',
		url: new URL('/', Astro.site).href,
		description: 'A deterministic CLI that orchestrates code-quality tools across multiple programming ecosystems.',
		applicationCategory: 'DeveloperApplication',
		applicationSubCategory: 'Code quality tool',
		operatingSystem: ['Linux', 'macOS', 'Windows'],
		isAccessibleForFree: true,
		license: 'https://opensource.org/license/mit',
		codeRepository: 'https://github.com/santi020k/quality',
		downloadUrl: 'https://github.com/santi020k/quality/releases',
		offers: {
			'@type': 'Offer',
			price: 0,
			priceCurrency: 'USD',
		},
	},
];

if (pageType === 'article') {
	graph.push(
		{
			'@type': 'TechArticle',
			'@id': `${canonical.href}#article`,
			headline: sectionName ?? title,
			description,
			url: canonical.href,
			mainEntityOfPage: canonical.href,
			isPartOf: { '@id': websiteId },
			about: { '@id': softwareId },
			inLanguage: 'en',
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{
					'@type': 'ListItem',
					position: 1,
					name: 'Documentation',
					item: new URL('/getting-started/', Astro.site).href,
				},
				{
					'@type': 'ListItem',
					position: 2,
					name: sectionName ?? title,
					item: canonical.href,
				},
			],
		},
	);
}

const structuredData = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#2563eb" />
		<meta property="og:type" content={pageType} />
		<meta property="og:site_name" content="quality" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:alt" content="quality — one quality command for every project" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<title>{title}</title>
		<script is:inline>
			const theme = localStorage.getItem('quality-theme');
			if (theme) document.documentElement.dataset.theme = theme;
		</script>
	</head>
	<body>
		<UIPrimitives />
		<SkipLink href="#main-content">Skip to content</SkipLink>
		<div class="site-shell">
			<header class="site-header">
				<nav class="site-nav" aria-label="Primary navigation">
					<a class="wordmark" href="/" aria-label="quality home">
						<img class="wordmark-mark" src="/logo.svg" alt="" width="32" height="32" />
						<span>quality</span>
					</a>
					<div class="nav-links">
						<a class="nav-link" href="/overview/" aria-current={Astro.url.pathname === '/overview/' ? 'page' : undefined}>Why quality</a>
						<a class="nav-link" href="/getting-started/" aria-current={isDocs ? 'page' : undefined}>Docs</a>
						<a class="nav-link" href="/adapters/" aria-current={Astro.url.pathname === '/adapters/' ? 'page' : undefined}>Adapters</a>
					</div>
					<div class="nav-actions">
						<ThemeToggle aria-label="Toggle color theme" storageKey="quality-theme" />
						<ButtonLink class="github-link" href="https://github.com/santi020k/quality" newTab variant="ghost">GitHub</ButtonLink>
					</div>
				</nav>
			</header>
			<main class="site-main" id="main-content"><slot /></main>
			<footer class="site-footer">
				<div class="footer-inner">
					<span>Built for teams that care about the details.</span>
					<div class="footer-links">
						<a href="/getting-started/">Documentation</a>
						<a href="https://github.com/santi020k/quality">Source</a>
					</div>
				</div>
			</footer>
		</div>
	</body>
</html>
