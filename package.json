{
  "name": "@quality-preset-e2e/quality-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "One deterministic code-quality workflow for multi-platform repositories.",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "cargo run --quiet --package quality-cli -- check",
    "check:packages": "turbo run check",
    "check:action-dist": "pnpm --filter @quality/action run build && git diff --exit-code -- packages/action/dist && test -z \"$(git ls-files --others --exclude-standard packages/action/dist)\"",
    "check:security": "pnpm audit --audit-level low",
    "check:versions": "node --test scripts/*.test.mjs && node scripts/sync-release-version.mjs --check",
    "changeset": "changeset",
    "commit": "commitprompt",
    "test": "turbo run test && pnpm playground:verify",
    "dev": "turbo run dev --filter=@quality/site",
    "playground": "sh playground/run.sh",
    "playground:setup": "sh playground/setup.sh",
    "playground:verify": "sh playground/verify.sh",
    "ci": "node scripts/affected-ci.mjs",
    "ci:plan": "node scripts/affected-ci.mjs --plan",
    "benchmark:ci": "node scripts/benchmark-ci.mjs",
    "validate": "pnpm run check && pnpm run test && pnpm run build && pnpm run check:security && pnpm run check:versions && pnpm run check:action-dist",
    "version-packages": "changeset version && node scripts/sync-release-version.mjs && cargo check --quiet --package quality-cli && pnpm install --lockfile-only",
    "pre-push": "pnpm run validate",
    "hooks:install": "cargo run --quiet --package quality-cli -- hooks install",
    "test:site": "pnpm --filter @quality/site test:browser"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@santi020k/commitprompt": "1.1.0",
    "cspell": "10.3.6",
    "turbo": "2.11.7",
    "wrangler": "4.148.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santi020k/quality.git"
  },
  "author": {
    "name": "Santiago Molina",
    "url": "https://santi020k.com"
  },
  "bugs": {
    "url": "https://github.com/santi020k/quality/issues"
  },
  "homepage": "https://github.com/santi020k/quality#readme"
}
