{
  "name": "quality-monorepo",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "dev": "turbo run dev --filter=@quality/site",
    "ci": "turbo run check --affected && turbo run test --affected && turbo run build --affected"
  },
  "devDependencies": {
    "turbo": "2.10.11"
  }
}
