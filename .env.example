# Copy this file to `.env` for local release or documentation work.
# Never commit real credentials. Production values belong in Infisical or
# GitHub repository secrets and variables.

# Fine-grained token for the Release PR workflow when the repository does not
# allow github.token to create pull requests. Grant only Contents and Pull
# requests read/write access.
CHANGESETS_TOKEN=

# Optional GitHub API token for local repository operations.
GH_TOKEN=

# Infisical OIDC metadata used by the connection-check workflow.
INFISICAL_IDENTITY_ID=
INFISICAL_PROJECT_SLUG=

# Optional Turborepo remote-cache credentials.
TURBO_TOKEN=
TURBO_TEAM=
TURBO_CONCURRENCY=10
TURBO_REMOTE_CACHE_TIMEOUT=30

# Canonical public documentation URL.
PUBLIC_SITE_URL=https://quality.santi020k.com

# Cloudflare deployment credentials are Actions secrets, not local defaults.
# Grant only the account and Workers permissions needed by quality-site.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
