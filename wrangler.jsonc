{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quality-site",
  "compatibility_date": "2026-08-22",
  "routes": [
    {
      "pattern": "quality.santi020k.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./apps/site/.astro-dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
