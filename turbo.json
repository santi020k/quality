{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["Cargo.toml", "Cargo.lock", "templates/**", "install.sh", "apps/site/public/quality*.schema.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro-dist/**"]
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@quality/cli#build": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
